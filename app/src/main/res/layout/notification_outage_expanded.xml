<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/notifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="Оновлено графік на сьогодні"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Color-coded diff lines (Додано / Прибрано / Змінено) -->
    <TextView
        android:id="@+id/notifDiffSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFeatureSettings="tnum"
        android:lineSpacingExtra="3dp"
        android:text=""
        android:textColor="@color/text_body"
        android:textSize="11sp" />

    <!-- Було / Стало mini timelines (12h window, 2h ticks, no scroll) -->
    <LinearLayout
        android:id="@+id/notifTimelinesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/notifBeforeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Було"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notifBeforeBar"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notifAfterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Стало"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/notifAfterBar"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
