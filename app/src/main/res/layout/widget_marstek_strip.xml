<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Left Gauge (no %) -->
    <FrameLayout
        android:id="@+id/stripGaugeContainer"
        android:layout_width="42dp"
        android:layout_height="42dp">

        <ImageView
            android:id="@+id/stripGaugeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/stripSocText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="#F2F4F5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Middle Info -->
    <LinearLayout
        android:id="@+id/stripInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/stripModeIcon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mode_idle" />

            <TextView
                android:id="@+id/stripTopMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="Очікування"
                android:textColor="#8FA3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stripWattsTempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="· --°C"
                android:textColor="#C9CFD5"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/stripDurationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="0 Вт·год"
            android:textColor="#F2F4F5"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Outage Pill -->
    <LinearLayout
        android:id="@+id/stripOutagePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_card_bg"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/stripOutageRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="Без в."
            android:textColor="#FFC24D"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stripOutageAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text=""
            android:textColor="#A8B0B8"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Refresh Button -->
    <FrameLayout
        android:id="@+id/stripRefreshBtn"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/refresh_btn_bg">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_refresh" />
    </FrameLayout>

</LinearLayout>
